module RestoreEngine exposing
    ( Options, defaults
    , process
    , deviceTier, DeviceTier(..)
    )

{-| On-device photo restoration — the `canopy/inference` capability.

`RestoreEngine` runs an ONNX model over a decoded image **entirely in native C++**, where
the model runtime (ONNX Runtime, the CPU execution provider) and the memory budget live. It
consumes a `Native.Blob.Image` (a blob living in `canopy/native`'s `BlobRegistry`, from
`Image.decode`, `Photos.pick`, …) and produces a NEW `Native.Blob.Image` for the restored result — **pixels never cross the ABI**, only the
opaque integer handles do (see `canopy/image` and `plan/canopy` handle discipline).

Unlike the pure-Java capabilities (Photos, Share, Storage) that reuse the generic
`canopy::JniModule`, `RestoreEngine` is backed by a REAL C++ `NativeModule`
(`RestoreEngineModule`, the ORT sibling of `EchoModule`): the heavy tensor work runs on its
own worker thread and the completion is hopped back to the JS thread, exactly the C1 gate.

    call → ORT worker thread → ctx.complete → postToJs → __canopy_resolve → update

`process` is a one-shot async `Cmd` — a `Task` over `Native.Module.call "RestoreEngine"`,
exactly like `Image.decode` is a `Task` over `Native.Module.call "Image"`. There is no
`subscription` (no streaming progress), so this is an ordinary module, not an `effect
module`. (A future progress-reporting variant would graduate to a `canopy/*` effect module
using `Native.Module.callStreaming`, like the billing/batch ticks in `Echo.ticks`.)

The restored result is the same `Native.Blob.Image` type every image capability uses, so it
goes straight into `Album.save`, `ShareImage.image`, `Image.resize` or `Native.Blob.bitmap`, and
is freed with `Native.Blob.release`.

> **Model note — STAND-IN, not the real face model.** The bundled model is ESPCN
> `super-resolution-10.onnx`, a **single-channel (Y / luma) 3× super-resolution** network.
> It is a *stand-in* that proves the full ORT path (decode → tensor → session → recombine →
> blob). It is NOT a face-restoration or colorization model: the `restoreFaces` and
> `colorize` options are accepted and forwarded for API stability but the stand-in does not
> implement them (the host honors `upscale` via the super-res pass and blends by `strength`).
> Swapping in a real GFPGAN/CodeFormer/DDColor `.onnx` is a host-side asset + tensor-shape
> change only; this Canopy API is unchanged.

    import Native.Blob as Blob
    import Native.Module as NM
    import RestoreEngine

    type Msg
        = Restored (Result NM.Error Blob.Image)

    -- restore a decoded photo with default options:
    RestoreEngine.process picked RestoreEngine.defaults Restored

    -- show the result (zero-copy native view, same blob registry as canopy/image):
    Blob.bitmap [ A.width 320, A.height 240 ] restored

# Options
@docs Options, defaults

# Restoration
@docs process

# Capability probe
@docs deviceTier, DeviceTier

-}

import Json.Decode as Decode
import Json.Encode as Encode
import Native.Blob as Blob
import Native.Module as NM
import Task



-- OPTIONS


{-| How to restore. The host honors `upscale` (the ESPCN super-res pass) and `strength`
(0..1, how strongly the restored result is blended over a bicubic baseline); `restoreFaces`
and `colorize` are forwarded for API stability but are no-ops with the ESPCN stand-in model
(see the module note).

  - `upscale` — run the super-resolution pass (3× with the bundled ESPCN model).
  - `restoreFaces` — request face enhancement (stand-in: no-op).
  - `colorize` — request colorization of a grayscale source (stand-in: no-op).
  - `strength` — 0..1 blend of the model output over a plain bicubic upscale.

-}
type alias Options =
    { upscale : Bool
    , restoreFaces : Bool
    , colorize : Bool
    , strength : Float
    }


{-| Sensible defaults: upscale on, face/colorize off, full strength. -}
defaults : Options
defaults =
    { upscale = True
    , restoreFaces = False
    , colorize = False
    , strength = 1.0
    }


encodeOptions : Options -> Encode.Value
encodeOptions opts =
    Encode.object
        [ ( "upscale", Encode.bool opts.upscale )
        , ( "restoreFaces", Encode.bool opts.restoreFaces )
        , ( "colorize", Encode.bool opts.colorize )
        , ( "strength", Encode.float (clamp 0.0 1.0 opts.strength) )
        ]



-- RESTORATION


{-| Restore `image` (any decoded image: `Image.decode`, `Photos.pick`, …) with `options`,
producing a NEW image for the result. The input is NOT consumed — release both if you keep both
(`Native.Blob.release`; the GC never sees the pixels). The work runs on a native ORT worker
thread; cancelling the spawned `Process` calls `__canopy_cancel`, which the host honors between
tensor steps.

    RestoreEngine.process picked RestoreEngine.defaults Restored

-}
process : Blob.Image -> Options -> (Result NM.Error Blob.Image -> msg) -> Cmd msg
process image options toMsg =
    NM.call "RestoreEngine"
        "process"
        (Encode.object
            [ ( "image", Encode.int (Blob.toInt image) )
            , ( "options", encodeOptions options )
            ]
        )
        Blob.decoder
        |> Task.attempt toMsg



-- CAPABILITY PROBE


{-| Which compute path the host would use for inference. A stub today (the ESPCN stand-in
always runs on the CPU execution provider); a real build reports NNAPI/GPU/CPU so a UI can
warn before a slow restore. -}
type DeviceTier
    = Cpu
    | Nnapi
    | Gpu
    | Unknown String


{-| Probe the device's inference tier (see `DeviceTier`). One-shot async `Cmd`. -}
deviceTier : (Result NM.Error DeviceTier -> msg) -> Cmd msg
deviceTier toMsg =
    NM.call "RestoreEngine" "deviceTier" (Encode.object []) deviceTierDecoder
        |> Task.attempt toMsg


deviceTierDecoder : Decode.Decoder DeviceTier
deviceTierDecoder =
    Decode.field "tier" Decode.string
        |> Decode.map
            (\tier ->
                case tier of
                    "cpu" ->
                        Cpu

                    "nnapi" ->
                        Nnapi

                    "gpu" ->
                        Gpu

                    other ->
                        Unknown other
            )
