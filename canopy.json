{
    "type": "package",
    "name": "canopy/inference",
    "summary": "On-device inference via ONNX Runtime: a native RestoreEngine (image restoration in C++) and a browser StemSeparator (4-stem music separation on ORT-web, WebGPU or WASM SIMD, in a Worker)",
    "license": "BSD-3-Clause",
    "version": "2.0.0",
    "exposed-modules": [
        "RestoreEngine",
        "StemSeparator"
    ],
    "canopy-version": "0.19.0 <= v < 0.20.0",
    "dependencies": {
        "canopy/core": "1.0.0 <= v < 2.0.0",
        "canopy/json": "1.0.0 <= v < 2.0.0",
        "canopy/native": "0.2.0 <= v < 1.0.0",
        "canopy/file": "2.0.0 <= v < 3.0.0"
    },
    "test-dependencies": {
        "canopy/test": "3.0.0 <= v < 4.0.0"
    }
}
